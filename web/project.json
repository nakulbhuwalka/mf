{
  "name": "web",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "web/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vite build",
        "cwd": "web"
      },
      "inputs": ["{projectRoot}/package.json", "{projectRoot}/index.html", "{projectRoot}/*.{ts,json}", "{projectRoot}/src/**/*"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run",
        "cwd": "web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm vite",
        "cwd": "web"
      }
    }
  }
}
