{
  "name": "fund-data",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/fund-data/src",
  "implicitDependencies": ["db-migrations"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn -q package -DskipTests",
        "cwd": "services/fund-data"
      },
      "inputs": ["{projectRoot}/pom.xml", "{projectRoot}/src/main/**/*"],
      "outputs": ["{projectRoot}/target"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "mvn -q test",
        "cwd": "services/fund-data"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "mvn spring-boot:run",
        "cwd": "services/fund-data"
      }
    }
  }
}
