{
  "name": "statement-parser",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/statement-parser/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv build",
        "cwd": "services/statement-parser"
      },
      "inputs": ["{projectRoot}/pyproject.toml", "{projectRoot}/uv.lock", "{projectRoot}/src/**/*"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "services/statement-parser"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "uv run uvicorn statement_parser.main:app --port 8082",
        "cwd": "services/statement-parser"
      }
    }
  }
}
